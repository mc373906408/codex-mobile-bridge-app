<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP is an explicit user choice; it also permits fetching signed CA CRLs.
         Rust keeps credentials scoped to the exact origin; TLS uses system trust. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
